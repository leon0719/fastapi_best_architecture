# 複製成 .env.local 後填入實際值:  cp .env.local.example .env.local
#
# .env.local / .env.prod 一律不進版控(見 .gitignore)。
# 標為 CHANGEME 的值若原封不動帶到 DEBUG=False 的環境,啟動時會被
# Config.enforce_secure_settings() 擋下來,並明講是哪一項沒改。
#
# ENV 決定 pydantic Settings 要載入哪個 .env 檔(app/common/core/config.py 用
# os.getenv("ENV") 選檔)。未設定時預設就是 local,所以本地開發不用特別 export。
ENV=local

DEBUG=True

# ===================
# Admin Panel
# ===================
# Session 簽章金鑰。產生方式:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 外洩 = 任何人都能偽造 admin session。每個環境各自一把,勿共用、勿進版控。
ADMIN_SECRET_KEY=CHANGEME-generate-with-secrets-token-urlsafe-48

# Admin 登入帳密。任一項留空 → admin 面板直接拒絕登入(不是無密碼放行)。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME-use-a-strong-password

# ===================
# PostgreSQL
# ===================
# db/redis 為 docker-compose-dev.yml 裡的 service name。app 一律在容器內執行
# (make migrate 等指令都是 docker compose exec),不再需要另外一份 localhost
# 設定給本機直連用。
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGEME-strong-db-password
DB_NAME=fastapi_db

# ===================
# Redis
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME-strong-redis-password
REDIS_DB=0
REDIS_DECODE_RESPONSES=True

# 複製成 .env.local 後填入實際值:  cp .env.local.example .env.local
#
# .env.local / .env.prod 一律不進版控(見 .gitignore)。
# 標為 CHANGEME 的值若原封不動帶到 DEBUG=False 的環境,啟動時會被
# Config.enforce_secure_settings() 擋下來,並明講是哪一項沒改。
#
# ENV 決定 pydantic Settings 要載入哪個 .env 檔(app/common/core/config.py 用
# os.getenv("ENV") 選檔)。未設定時預設就是 local,所以本地開發不用特別 export。
ENV=local

DEBUG=True

# ===================
# Admin Panel
# ===================
# Session 簽章金鑰。產生方式:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 外洩 = 任何人都能偽造 admin session。每個環境各自一把,勿共用、勿進版控。
ADMIN_SECRET_KEY=CHANGEME-generate-with-secrets-token-urlsafe-48

# Admin 登入帳密。任一項留空 → admin 面板直接拒絕登入(不是無密碼放行)。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME-use-a-strong-password

# ===================
# PostgreSQL
# ===================
# db/redis 為 docker-compose-dev.yml 裡的 service name。app 一律在容器內執行
# (make migrate 等指令都是 docker compose exec),不再需要另外一份 localhost
# 設定給本機直連用。
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGEME-strong-db-password
DB_NAME=fastapi_db

# ===================
# Redis
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME-strong-redis-password
REDIS_DB=0
REDIS_DECODE_RESPONSES=True

# ===================
# 可觀測性 / CORS
# ===================
# Sentry:留空 = 不啟用。要測試時填 DSN 並打 GET /debug/sentry(只有 DEBUG=True 才有這個路由)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# 逗號分隔;DEBUG=False 時必須全部是 https://
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# ===================
# Rate limit
# ===================
RATE_LIMIT_ENABLED=True
# 留空 = 用上面的 Redis(多 worker 共用計數);memory:// 只適合單 worker
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_AUTH=10/minute

# ===================
# Google 登入(OAuth + PKCE);CLIENT_ID 留空 = 不啟用
# ===================
# Google Cloud Console → OAuth client(Web);redirect URI 填 http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=CHANGEME-google-oauth-client-secret
# 只接受這個 Workspace 網域(ID token 的 hd);留空 = 不限網域
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_AUTO_REGISTER=False
AUTH_SESSION_TTL_DAYS=30

# ===================
# 稽核 / 排程 / 長任務
# ===================
AUDIT_RETENTION_DAYS=365
SCHEDULER_ENABLED=True
JOB_TTL_SECONDS=86400

# ===================
# 檔案儲存(local | s3)
# ===================
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=media
STORAGE_MAX_UPLOAD_MB=10
AWS_REGION=ap-northeast-1
S3_BUCKET=
# 留空 = boto3 預設憑證鏈
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===================
# 通知
# ===================
# SMTP_HOST 留空 = 不寄信、只寫 log(本機開發建議保持留空,避免寄出真信)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=CHANGEME-smtp-password
SMTP_FROM_EMAIL=
# LINE Messaging API;ACCESS_TOKEN 留空 = 不推播、只寫 log;SECRET 留空 = webhook 一律拒絕
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_INTERVAL_SECONDS=60
# 已送出/已放棄的通知保留天數(每日清理;待送的不刪);0 = 永久保存
NOTIFICATION_RETENTION_DAYS=30

# ===================
# LLM(選用:uv sync --extra llm);LLM_PROVIDERS 留空 = 不啟用,依序 fallback
# ===================
LLM_PROVIDERS=
ANTHROPIC_API_KEY=CHANGEME-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=CHANGEME-openai-api-key
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=CHANGEME-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# 複製成 .env.prod 後填入實際值:  cp .env.prod.example .env.prod
# 請 chmod 600 .env.prod(.env.* 已在 .gitignore,不會進版控)。
# 提醒:以 env_file 注入的機密會出現在容器環境變數,能執行 `docker inspect`
# 者可讀。單機、docker 存取權受控時可接受;多人共用 daemon 時再改用 Docker
# secrets / 外部 secrets manager。
#
# ENV 決定 pydantic Settings 要載入哪個 .env 檔(app/common/core/config.py 用
# os.getenv("ENV") 選檔),所以它必須由「process 環境」提供 —— Docker 走
# compose 的 env_file 注入所以沒問題;裸機部署請先 `export ENV=prod`,
# 只寫在本檔內是無效的(雞生蛋:檔案被選中前就需要它)。
ENV=prod

DEBUG=False

# ===================
# Admin Panel
# ===================
# Session 簽章金鑰。產生方式:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 外洩 = 任何人都能偽造 admin session。每個環境各自一把,勿共用、勿進版控。
ADMIN_SECRET_KEY=<generate-new-key>

# Admin 登入帳密。任一項留空 → admin 面板直接拒絕登入(不是無密碼放行)。
ADMIN_USERNAME=<set-a-real-username>
ADMIN_PASSWORD=<use-a-strong-password>

# ===================
# PostgreSQL
# ===================
# db/redis 為 docker-compose.yml 裡的 service name(容器內部連線)。
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<strong-db-password>
DB_NAME=fastapi_db

# ===================
# Redis
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<strong-redis-password>
REDIS_DB=0
REDIS_DECODE_RESPONSES=True

# ===================
# 部署(docker-compose.yml 與 uvicorn)
# ===================
# app 只綁 127.0.0.1:APP_PORT,由 host nginx 反向代理(nginx/app.conf 的 proxy_pass 要一致)
APP_PORT=8000
# uvicorn worker 數;多 worker 時 rate limit / 排程鎖 / 長任務狀態都靠 Redis 共用
WEB_CONCURRENCY=2
# SIGTERM 後等進行中的請求最多幾秒(要小於 compose 的 stop_grace_period 30s)
GRACEFUL_TIMEOUT=25

# 每日異地備份(compose 的 backup 服務);留空 = 停用。權限優先用 EC2 instance role
BACKUP_S3_URI=s3://CHANGEME-backup-bucket/db-backups
BACKUP_INTERVAL_SECONDS=86400
# 非 EC2 主機才填(只給這個 prefix 的 s3:PutObject)
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# ===================
# 可觀測性 / CORS
# ===================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# 逗號分隔,必須 https://(DEBUG=False 時不安全的值會擋下啟動)
CORS_ORIGINS=https://CHANGEME-frontend.example.com
FRONTEND_BASE_URL=https://CHANGEME-frontend.example.com

# ===================
# Rate limit
# ===================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_AUTH=10/minute

# ===================
# Google 登入;CLIENT_ID 留空 = 不啟用
# ===================
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_ALLOWED_DOMAIN=<your-workspace-domain>
GOOGLE_AUTO_REGISTER=False
AUTH_SESSION_TTL_DAYS=30

# ===================
# 稽核 / 排程 / 長任務
# ===================
AUDIT_RETENTION_DAYS=365
SCHEDULER_ENABLED=True
JOB_TTL_SECONDS=86400

# ===================
# 檔案儲存
# ===================
STORAGE_BACKEND=s3
STORAGE_MAX_UPLOAD_MB=10
AWS_REGION=ap-northeast-1
S3_BUCKET=<s3-bucket-name>
# 建議留空,用 EC2 instance role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===================
# 通知
# ===================
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_EMAIL=<noreply@your-domain>
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_INTERVAL_SECONDS=60
# 已送出/已放棄的通知保留天數(每日清理;待送的不刪);0 = 永久保存
NOTIFICATION_RETENTION_DAYS=30

# ===================
# LLM(映像需以 --extra llm 建置);留空 = 不啟用
# ===================
LLM_PROVIDERS=
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

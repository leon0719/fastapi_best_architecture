# 複製成 .env.prod 後填入實際值:  cp .env.prod.example .env.prod
# 請 chmod 600 .env.prod(.env.* 已在 .gitignore,不會進版控)。
# 提醒:以 env_file 注入的機密會出現在容器環境變數,能執行 `docker inspect`
# 者可讀。單機、docker 存取權受控時可接受;多人共用 daemon 時再改用 Docker
# secrets / 外部 secrets manager。
#
# ENV 決定 pydantic Settings 要載入哪個 .env 檔(app/common/core/config.py 用
# os.getenv("ENV") 選檔),所以它必須由「process 環境」提供 —— Docker 走
# compose 的 env_file 注入所以沒問題;裸機部署請先 `export ENV=prod`,
# 只寫在本檔內是無效的(雞生蛋:檔案被選中前就需要它)。
ENV=prod

DEBUG=False

# ===================
# Admin Panel
# ===================
# Session 簽章金鑰。產生方式:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 外洩 = 任何人都能偽造 admin session。每個環境各自一把,勿共用、勿進版控。
ADMIN_SECRET_KEY=<generate-new-key>

# Admin 登入帳密。任一項留空 → admin 面板直接拒絕登入(不是無密碼放行)。
ADMIN_USERNAME=<set-a-real-username>
ADMIN_PASSWORD=<use-a-strong-password>

# ===================
# PostgreSQL
# ===================
# db/redis 為 docker-compose.yml 裡的 service name(容器內部連線)。
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<strong-db-password>
DB_NAME=fastapi_db

# ===================
# Redis
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<strong-redis-password>
REDIS_DB=0
REDIS_DECODE_RESPONSES=True

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make all)",
      "Bash(make format)",
      "Bash(make lint)",
      "Bash(make type-check)",
      "Bash(make test*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(make audit)",
      "Bash(make sast)",
      "Bash(make migration-history)"
    ],
    "deny": [
      "Bash(make prod-*)",
      "Bash(*-f docker-compose.yml*)",
      "Bash(make docker-clean*)",
      "Bash(git push*)",
      "Read(./.env.prod)",
      "Bash(*.env.prod*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-human-only.sh"
          }
        ]
      }
    ]
  }
}
